---
import { site, nav } from "../config/site";
import { footer } from "../config/content";
import Icon from "./ui/Icon.astro";
import Button from "./ui/Button.astro";
const year = new Date().getFullYear();
const waLink = `https://wa.me/${site.contact.whatsapp}`;
const addr = site.contact.address;
---

<footer class="bg-dark text-cream/80">
  <div class="container-x">
    <!-- CTA de eventos -->
    <div class="flex flex-wrap items-center justify-between gap-6 border-b border-cream/15 py-12 sm:py-16">
      <h2 class="max-w-[16ch] font-display text-3xl text-white sm:text-4xl">{footer.ctaTitle}</h2>
      <Button href={footer.ctaHref} variant="primary">{footer.ctaButtonLabel}</Button>
    </div>

    <div class="grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4 sm:py-16">
      <!-- Marca -->
      <div>
        <p class="font-display text-lg font-semibold text-white">{site.name}</p>
        <p class="mt-3 text-sm leading-relaxed text-cream/70">{footer.brandOneLiner}</p>
      </div>

      <!-- Navegação -->
      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-widest text-orange-soft">Explorar</p>
        <ul class="space-y-2 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-cream/70 transition-colors hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Visite -->
      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-widest text-orange-soft">Visite</p>
        <p class="text-sm leading-relaxed text-cream/70">
          {addr.streetAddress}<br />
          {addr.neighborhood}<br />
          {addr.addressLocality}/{addr.addressRegion}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-cream/70">
          {site.contact.hoursDisplay.weekdays}<br />
          {site.contact.hoursDisplay.saturday}
        </p>
      </div>

      <!-- Fale com a gente -->
      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-widest text-orange-soft">Fale com a gente</p>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={waLink} target="_blank" rel="noopener" class="text-cream/70 hover:text-white">
              WhatsApp {site.contact.whatsappDisplay}
            </a>
          </li>
          <li>
            <a href={`tel:${site.contact.phone}`} class="text-cream/70 hover:text-white">
              {site.contact.phoneDisplay}
            </a>
          </li>
          {
            site.social.instagram && (
              <li>
                <a
                  href={site.social.instagram}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-2 text-cream/70 hover:text-white"
                >
                  <Icon name="instagram" class="size-4" /> Instagram @duocoffeepp
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap justify-between gap-4 border-t border-cream/15 py-6 text-xs text-cream/50">
      <span>© {year} {site.name}. Todos os direitos reservados.</span>
      <a href={footer.privacyHref} class="hover:text-white">{footer.privacyLabel}</a>
    </div>
  </div>
</footer>
