---
/**
 * Ícones em SVG inline. Sem biblioteca, sem requisição extra.
 * Adicione novos ícones ao objeto `paths`. Todos herdam a cor
 * via currentColor e o traço fica consistente.
 */
interface Props {
  name: string;
  class?: string;
}
const { name, class: extra = "size-6" } = Astro.props;

const paths: Record<string, string> = {
  // faixa de credenciais
  calendar: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2",
  bean: "M12 3c4 3 5 7 2 10-2 2-6 2-8 0M12 3c-1 4 0 7 2 9",
  filter: "M6 3v4M10 3v4M8 7v3a3 3 0 0 0 6 0M5 21h14M9 13c0 4-3 4-3 8M15 13c0 4 3 4 3 8",
  cup: "M4 10h13a3 3 0 0 1 0 6h-1M4 10v5a4 4 0 0 0 4 4h4a4 4 0 0 0 4-4v-5zM8 3c-.6 1 .6 1.5 0 2.5M12 3c-.6 1 .6 1.5 0 2.5",
  // utilitários
  whatsapp:
    "M12 3a9 9 0 00-7.7 13.6L3 21l4.5-1.2A9 9 0 1012 3zM8.5 8.5c.2-.5.4-.5.6-.5h.5c.2 0 .4 0 .6.5l.7 1.6c.1.2.1.4 0 .6l-.5.6c-.1.2-.2.3 0 .6.6 1 1.4 1.7 2.4 2.2.3.2.5.1.6 0l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .6-.3 1.3-1.4 1.6-1 .3-2.8 0-4.8-1.7-1.8-1.5-2.6-3.2-2.7-4.2-.1-.9.3-1.5.7-1.9z",
  phone:
    "M5 4h3l2 5-2 1.5a11 11 0 005.5 5.5L20 14l5 2v3a2 2 0 01-2 2C12 21 3 12 3 6a2 2 0 012-2z",
  mail: "M3 6h18v12H3V6zm0 1l9 6 9-6",
  map: "M12 21s-6-5.3-6-10a6 6 0 1112 0c0 4.7-6 10-6 10zm0-7.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z",
  clock: "M12 7v5l3 2M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  instagram:
    "M7 3h10a4 4 0 014 4v10a4 4 0 01-4 4H7a4 4 0 01-4-4V7a4 4 0 014-4zm5 5.5a3.5 3.5 0 100 7 3.5 3.5 0 000-7zM17 6.5h.01",
  arrow: "M5 12h14M13 6l6 6-6 6",
  plus: "M12 5v14M5 12h14",
};

const d = paths[name] ?? "";
---

<svg
  class={extra}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d} />
</svg>
