---
/**
 * SEO + dados estruturados.
 * - Meta tags e Open Graph para Google e redes sociais.
 * - JSON-LD (CafeOrCoffeeShop) para SEO local e leitura por IAs.
 *   É o que faz o negócio ser "entendido" por buscadores e LLMs,
 *   não só indexado.
 */
import { site } from "../config/site";
import { faq as faqItems } from "../config/content";

interface Props {
  title?: string;
  description?: string;
  /** caminho da página, ex.: "/politica-de-privacidade" — default é a home */
  path?: string;
  /** true para páginas que não devem ser indexadas (ex.: obrigado, rascunho) */
  noindex?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  path = "/",
  noindex = false,
} = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImage = new URL(site.seo.ogImage, site.url).href;
const { address, geo } = site.contact;
const hasGeo = geo.latitude != null && geo.longitude != null;

// Dados estruturados: descreve o negócio para máquinas (subtipo mais
// específico que Google recomenda para cafeterias).
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  name: site.name,
  legalName: site.legalName,
  description,
  url: site.url,
  image: [ogImage],
  telephone: site.contact.phone,
  email: site.contact.email,
  priceRange: site.business.priceRange,
  servesCuisine: site.business.cuisine,
  address: {
    "@type": "PostalAddress",
    streetAddress: address.streetAddress,
    addressLocality: address.addressLocality,
    addressRegion: address.addressRegion,
    ...(address.postalCode ? { postalCode: address.postalCode } : {}),
    addressCountry: address.addressCountry,
  },
  // Nunca fabricar coordenada: só emite `geo` quando confirmado em site.ts.
  ...(hasGeo
    ? { geo: { "@type": "GeoCoordinates", latitude: geo.latitude, longitude: geo.longitude } }
    : {}),
  openingHoursSpecification: site.contact.hours.map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: h.dayOfWeek,
    opens: h.opens,
    closes: h.closes,
  })),
  menu: `${site.url}/#cardapio`,
  sameAs: Object.values(site.social).filter(Boolean),
};

// FAQPage só é emitido com perguntas reais — nunca fabricar conteúdo (CLAUDE.md).
const faqJsonLd =
  faqItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqItems.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      }
    : null;
---

<!-- Básico -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content={site.name} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Dados estruturados -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
