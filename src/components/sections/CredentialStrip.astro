---
import { credentials } from "../../config/content";
import Icon from "../ui/Icon.astro";
---

<section class="border-y border-line bg-surface">
  <div class="container-x grid divide-y divide-line sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:grid-cols-4">
    {
      credentials.map((item) => (
        <div class="reveal flex items-start gap-3.5 px-1 py-7 sm:px-6">
          <Icon name={item.icon} class="mt-0.5 size-7 shrink-0 text-orange-t" />
          <div>
            <b class="block font-display text-lg font-medium text-ink">{item.label}</b>
            <span class="text-sm text-muted">{item.caption}</span>
          </div>
        </div>
      ))
    }
  </div>
</section>
