---
import { Image } from "astro:assets";
import { site } from "../../config/site";
import { events } from "../../config/content";
import { getImage } from "../../lib/images";
import Button from "../ui/Button.astro";

const mainImg = getImage(events.images.main.src);
const overlayImg = getImage(events.images.overlay.src);
const waLink = `https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(events.form.whatsappMessage)}`;
const f = events.form.fields;
---

<section id="eventos" class="bg-forest py-16 text-cream sm:py-24">
  <div class="container-x">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="reveal">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-orange-soft">{events.eyebrow}</p>
        <h2 class="mt-4 font-display text-[clamp(2.1rem,4.2vw,3.75rem)] text-white">{events.title}</h2>
        <p class="mt-5 max-w-[52ch] text-cream/80 leading-relaxed">{events.lede}</p>
        <ul class="mt-7 flex flex-col">
          {
            events.benefits.map((b, i) => (
              <li class="flex gap-3.5 border-t border-cream/15 py-4 text-[15px] last:border-b">
                <span class="font-display font-bold text-orange-soft">{String(i + 1).padStart(2, "0")}</span>
                {b}
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-cream/60">{events.note}</p>
      </div>

      <div class="relative reveal">
        <div class="aspect-[4/4.2] overflow-hidden rounded-[var(--radius-card)] bg-white/5">
          {
            mainImg && (
              <Image
                src={mainImg}
                alt={events.images.main.alt}
                widths={[400, 700, 1100]}
                sizes="(max-width: 1024px) 100vw, 45vw"
                quality={78}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            )
          }
        </div>
        <div class="absolute -bottom-7 -right-6 aspect-square w-[46%] overflow-hidden rounded-[var(--radius-card)] border-[7px] border-forest bg-white/5 shadow-[0_20px_50px_rgba(0,0,0,0.35)]">
          {
            overlayImg && (
              <Image
                src={overlayImg}
                alt={events.images.overlay.alt}
                widths={[200, 350, 500]}
                sizes="200px"
                quality={78}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            )
          }
        </div>
      </div>
    </div>

    <div class="mt-14 grid gap-10 border-t border-cream/15 pt-12 lg:grid-cols-[.9fr_1.1fr] lg:gap-16">
      <div class="reveal">
        <h3 class="font-display text-2xl text-white sm:text-3xl">{events.form.intro.title}</h3>
        <p class="mt-3.5 text-[15.5px] text-cream/75">{events.form.intro.body}</p>
        <Button href={waLink} target="_blank" rel="noopener" variant="whatsapp" class="mt-5">
          {events.form.whatsappLabel}
        </Button>
      </div>

      <div class="reveal">
        <div data-event-success hidden class="max-w-[560px] rounded-xl border border-orange-soft/50 bg-white/8 p-7">
          <h3 class="text-[1.6rem] text-white">{events.form.successTitle}</h3>
          <p class="mt-2.5 text-cream/80">{events.form.successBody}</p>
        </div>

        <form
          data-event-form
          action={events.form.action}
          method="POST"
          novalidate
          class="flex max-w-[560px] flex-col gap-4.5"
        >
          <div class="flex flex-col gap-1.5" data-field="nome">
            <label for="field-nome" class="text-[13px] font-bold text-cream/90">
              {f.nome.label} <span class="text-orange-soft" aria-hidden="true">*</span>
            </label>
            <input
              id="field-nome"
              name="nome"
              type="text"
              autocomplete="name"
              required
              class="min-h-[52px] rounded-lg border-[1.5px] border-cream/25 bg-white/6 px-4 py-3 text-white placeholder:text-cream/40 focus:border-orange"
            />
            <span class="hidden text-[13px] font-semibold text-orange-soft" data-error>Informe seu nome.</span>
          </div>

          <div class="flex flex-col gap-1.5" data-field="whatsapp">
            <label for="field-whatsapp" class="text-[13px] font-bold text-cream/90">
              {f.whatsapp.label} <span class="text-orange-soft" aria-hidden="true">*</span>
            </label>
            <input
              id="field-whatsapp"
              name="whatsapp"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              placeholder={f.whatsapp.placeholder}
              required
              class="min-h-[52px] rounded-lg border-[1.5px] border-cream/25 bg-white/6 px-4 py-3 text-white placeholder:text-cream/40 focus:border-orange"
            />
            <span class="hidden text-[13px] font-semibold text-orange-soft" data-error>
              Digite um número válido com DDD.
            </span>
          </div>

          <div class="flex flex-col gap-1.5" data-field="tipo">
            <label for="field-tipo" class="text-[13px] font-bold text-cream/90">
              {f.tipo.label} <span class="text-orange-soft" aria-hidden="true">*</span>
            </label>
            <select
              id="field-tipo"
              name="tipo"
              required
              class="min-h-[52px] rounded-lg border-[1.5px] border-cream/25 bg-white/6 px-4 py-3 text-white focus:border-orange"
            >
              <option value="">Selecione uma opção</option>
              {f.tipo.options?.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
            <span class="hidden text-[13px] font-semibold text-orange-soft" data-error>
              Selecione o tipo de evento.
            </span>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="field-data" class="text-[13px] font-bold text-cream/90">{f.data.label}</label>
            <input
              id="field-data"
              name="data"
              type="date"
              class="min-h-[52px] rounded-lg border-[1.5px] border-cream/25 bg-white/6 px-4 py-3 text-white focus:border-orange"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="field-pessoas" class="text-[13px] font-bold text-cream/90">{f.pessoas.label}</label>
            <input
              id="field-pessoas"
              name="pessoas"
              type="number"
              min="1"
              inputmode="numeric"
              placeholder={f.pessoas.placeholder}
              class="min-h-[52px] rounded-lg border-[1.5px] border-cream/25 bg-white/6 px-4 py-3 text-white placeholder:text-cream/40 focus:border-orange"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="field-msg" class="text-[13px] font-bold text-cream/90">{f.mensagem.label}</label>
            <textarea
              id="field-msg"
              name="mensagem"
              rows="3"
              placeholder={f.mensagem.placeholder}
              class="min-h-[110px] resize-y rounded-lg border-[1.5px] border-cream/25 bg-white/6 px-4 py-3 text-white placeholder:text-cream/40 focus:border-orange"
            ></textarea>
          </div>

          <div class="flex flex-col gap-1.5" data-field="consent">
            <label class="flex items-start gap-2.5 text-sm text-cream/85">
              <input id="field-consent" name="consent" type="checkbox" required class="mt-1 size-4" />
              <span>
                {events.form.consent.label}{" "}
                <a href={events.form.consent.href} class="text-orange-soft underline hover:text-white">
                  {events.form.consent.linkLabel}
                </a>
              </span>
            </label>
            <span class="hidden text-[13px] font-semibold text-orange-soft" data-error>
              É preciso concordar com a Política de Privacidade.
            </span>
          </div>

          <div>
            <button type="submit" class="w-full rounded-full bg-brand px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-brand-dark">
              {events.form.submitLabel}
            </button>
            <p class="mt-3 text-center text-[13px] text-cream/60">{events.form.requiredNote}</p>
            <p data-form-error hidden class="mt-3 text-center text-[13px] font-semibold text-orange-soft">
              Não foi possível enviar agora. Tente novamente ou chame no WhatsApp.
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector("[data-event-form]") as HTMLFormElement | null;
  const successBox = document.querySelector("[data-event-success]") as HTMLElement | null;
  const formError = document.querySelector("[data-form-error]") as HTMLElement | null;
  if (form) {
    const setInvalid = (field: HTMLElement | null, invalid: boolean) => {
      if (!field) return;
      const input = field.querySelector("input, select, textarea") as HTMLElement | null;
      const err = field.querySelector("[data-error]") as HTMLElement | null;
      input?.setAttribute("aria-invalid", String(invalid));
      err?.classList.toggle("hidden", !invalid);
    };

    const validate = () => {
      let firstInvalid: HTMLElement | null = null;
      let valid = true;

      const nomeField = form.querySelector('[data-field="nome"]') as HTMLElement;
      const nomeInput = form.querySelector("#field-nome") as HTMLInputElement;
      const nomeOk = nomeInput.value.trim().length > 1;
      setInvalid(nomeField, !nomeOk);
      if (!nomeOk && !firstInvalid) firstInvalid = nomeInput;
      valid &&= nomeOk;

      const waField = form.querySelector('[data-field="whatsapp"]') as HTMLElement;
      const waInput = form.querySelector("#field-whatsapp") as HTMLInputElement;
      const waOk = /^\d{10,11}$/.test(waInput.value.replace(/\D/g, ""));
      setInvalid(waField, !waOk);
      if (!waOk && !firstInvalid) firstInvalid = waInput;
      valid &&= waOk;

      const tipoField = form.querySelector('[data-field="tipo"]') as HTMLElement;
      const tipoInput = form.querySelector("#field-tipo") as HTMLSelectElement;
      const tipoOk = tipoInput.value !== "";
      setInvalid(tipoField, !tipoOk);
      if (!tipoOk && !firstInvalid) firstInvalid = tipoInput;
      valid &&= tipoOk;

      const consentField = form.querySelector('[data-field="consent"]') as HTMLElement;
      const consentInput = form.querySelector("#field-consent") as HTMLInputElement;
      const consentOk = consentInput.checked;
      setInvalid(consentField, !consentOk);
      if (!consentOk && !firstInvalid) firstInvalid = consentInput;
      valid &&= consentOk;

      firstInvalid?.focus();
      return valid;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      formError?.classList.add("hidden");
      if (!validate()) return;

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (res.ok) {
          form.hidden = true;
          successBox?.removeAttribute("hidden");
        } else {
          formError?.classList.remove("hidden");
        }
      } catch {
        formError?.classList.remove("hidden");
      }
    });
  }
</script>
