---
import { Image } from "astro:assets";
import { menu } from "../../config/content";
import { getImage } from "../../lib/images";
import Section from "../ui/Section.astro";

const featuredImg = getImage(menu.featured.image.src);
---

<Section id="cardapio" eyebrow={menu.eyebrow} title={menu.title} subtitle={menu.lede}>
  <div class="mt-10 grid gap-6 sm:grid-cols-2">
    <!-- Destaque sazonal -->
    <div class="reveal grid gap-0 overflow-hidden rounded-[var(--radius-card)] bg-forest text-cream sm:col-span-2 sm:grid-cols-[0.8fr_1.2fr]">
      <div class="aspect-[4/3] bg-white/5 sm:aspect-auto sm:min-h-[260px]">
        {
          featuredImg && (
            <Image
              src={featuredImg}
              alt={menu.featured.image.alt}
              widths={[400, 700, 1000]}
              sizes="(max-width: 640px) 100vw, 40vw"
              quality={78}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          )
        }
      </div>
      <div class="flex flex-col justify-center p-8 sm:p-11">
        <span class="mb-3.5 text-xs font-bold uppercase tracking-[0.18em] text-orange-soft">
          {menu.featured.tag}
        </span>
        <h3 class="font-display text-[1.9rem] text-white">{menu.featured.title}</h3>
        <p class="mt-3 max-w-[46ch] text-[15.5px] text-cream/90">{menu.featured.body}</p>
        <span class="mt-4.5 text-[13.5px] text-cream/70">{menu.featured.note}</span>
      </div>
    </div>

    <!-- Categorias -->
    {
      menu.items.map((item) => {
        const img = getImage(item.image.src);
        return (
          <div class="reveal">
            <figure class="m-0 aspect-[4/3.4] overflow-hidden rounded-[var(--radius-card)] bg-subtle">
              {img && (
                <Image
                  src={img}
                  alt={item.image.alt}
                  widths={[400, 700, 1100]}
                  sizes="(max-width: 640px) 100vw, 50vw"
                  quality={78}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              )}
            </figure>
            <h3 class="mt-4.5 font-display text-[1.35rem] text-ink">{item.title}</h3>
            <p class="mt-2 max-w-[38ch] text-[15px] text-muted">{item.description}</p>
          </div>
        );
      })
    }
  </div>

  <div class="mt-9 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
    <span class="text-[13px] text-muted">{menu.footnote}</span>
    <a href={menu.cta.href} class="font-semibold text-orange-t hover:text-ink">{menu.cta.label}</a>
  </div>
</Section>
