---
import "../styles/global.css";
import { site } from "../config/site";
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  /** true para páginas que não devem ser indexadas (ex.: 404). */
  noindex?: boolean;
}
const { title, description, path, noindex } = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="generator" content={Astro.generator} />

    <!-- Cor da marca vinda do config: reveste o site inteiro -->
    <style
      is:inline
      set:html={`:root{--brand:${site.brandColor};--brand-dark:${site.brandColorDark};}`}
    />

    <!-- Fraunces/Manrope são self-hospedadas via @fontsource,
         importadas em global.css — sem round-trip a CDN externa. -->

    <SEO title={title} description={description} path={path} noindex={noindex} />
  </head>
  <body>
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white">
      Pular para o conteúdo
    </a>

    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <!-- Reveal on scroll: leve, sem dependência, respeita reduced-motion -->
    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const els = document.querySelectorAll(".reveal");
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));

        // Rede de seguranca: se algo impedir o IntersectionObserver de
        // disparar (crawler sem scroll real, timing incomum), garante
        // que o conteudo nao fique preso em opacity:0 pra sempre.
        setTimeout(() => {
          els.forEach((el) => el.classList.add("is-visible"));
          io.disconnect();
        }, 3000);
      }
    </script>

    <!-- Scroll-spy: destaca o link da nav correspondente à seção visível -->
    <script>
      const sections = Array.from(document.querySelectorAll("main section[id]"));
      const navLinks = Array.from(
        document.querySelectorAll('#primary-nav a[href^="#"], #mobile-nav a[href^="#"]')
      ) as HTMLAnchorElement[];

      if (sections.length && navLinks.length && "IntersectionObserver" in window) {
        const setActive = (id: string) => {
          navLinks.forEach((link) => {
            link.classList.toggle("is-active", link.hash === `#${id}`);
          });
        };
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) setActive(entry.target.id);
            });
          },
          { rootMargin: "-40% 0px -55% 0px", threshold: 0 }
        );
        sections.forEach((s) => io.observe(s));
      }
    </script>
  </body>
</html>
